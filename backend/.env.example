PORT=3100
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventforge?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=8h
CLIENT_URL=https://your-frontend-domain.com

# Super Admin Bootstrap Credentials (Auto-provisioned on startup if database is empty)
ADMIN_NAME=Platform Super Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# AI Operating System Engine (Gemini, Anthropic, OpenAI, Groq)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
