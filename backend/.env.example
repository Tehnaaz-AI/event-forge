PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventforge?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-key
JWT_EXPIRES_IN=8h
CLIENT_URL=https://your-frontend-domain.com

# Super Admin Bootstrap Credentials (Auto-created on server boot)
ADMIN_NAME=Platform Super Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# AI Content Studio Engine (Gemini, OpenAI, Groq, or OpenRouter)
AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
